# Copy this file to ".env" and fill in ONE provider.
# (Keep comments on their own lines: "docker --env-file" does not understand comments after a value.)

# Provider: groq | gemini | openai | ollama
LLM_PROVIDER=groq

# Groq: free key from https://console.groq.com
GROQ_API_KEY=
# Gemini (LLM_PROVIDER=gemini): free key from https://aistudio.google.com
GOOGLE_API_KEY=
# OpenAI (LLM_PROVIDER=openai)
OPENAI_API_KEY=
# Ollama (LLM_PROVIDER=ollama) needs no key: install Ollama and run "ollama pull llama3.2"

# Optional overrides. Leave commented unless you need them.
# Set LLM_MODEL if the default model name is no longer offered by your provider.
# LLM_MODEL=
# Docker + Ollama running on your PC: http://host.docker.internal:11434/v1
# LLM_BASE_URL=
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=4
# If API_KEY is set, the FastAPI service requires the header X-API-Key
# API_KEY=
